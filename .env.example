# Versions fixades del desplegament. No s'utilitza latest.
OPEN_WEBUI_VERSION=v0.11.0
POSTGRES_IMAGE_TAG=pg16
TIKA_VERSION=3.1.0.0-full
LITELLM_VERSION=main-stable

# Imatge base de vLLM. VERIFICA abans de fixar-la que l'etiqueta triada té
# build linux/arm64 amb suport CUDA per al GB10 (Grace Blackwell) de la DGX
# Spark (docker manifest inspect <imatge>:<etiqueta>); si vllm/vllm-openai no
# n'ofereix, consulta el catàleg NGC de NVIDIA (nvcr.io) per imatges vLLM
# natives de DGX Spark.
VLLM_IMAGE=vllm/vllm-openai
VLLM_VERSION=v0.28.0

# UID/GID interns dels contenidors no privilegiats.
APP_UID=10001
APP_GID=10001

# Publicació local en la DGX (només loopback).
OPEN_WEBUI_PORT=3000
TIKA_HOST_PORT=9998
LITELLM_PORT=4000

# URLs publicades per Caddy. Un subdomini per servei perquè tant Open WebUI
# com la UI d'administració de LiteLLM assumeixen que s'executen en l'arrel
# del domini (vegeu caddy/Caddyfile).
WEBUI_URL=https://spark-6169.cipfpbatoi.lan
LITELLM_URL=https://api.spark-6169.cipfpbatoi.lan

# Orígens permesos per CORS (HTTP i WebSocket) d'Open WebUI, separats per ';'
# (Open WebUI fa CORS_ALLOW_ORIGIN.split(';'); una coma NO funciona i deixa
# tots els orígens bloquejats, també el WebSocket del xat en temps real).
# Per defecte només s'accepta WEBUI_URL. No hi ha cap origen de depuració
# (com http://localhost:3000) inclòs de sèrie: si accedeixes directament al
# contenidor per a proves (túnel SSH, port diferent de 443...), descomenta
# i afig ací els orígens que necessites NOMÉS en el teu .env local, mai en
# compose.yaml. L'origen ha de coincidir EXACTAMENT amb el que escrigues en
# el navegador (localhost i 127.0.0.1 no són el mateix origen). Sobreescriure
# substitueix tota la llista: inclou també WEBUI_URL si encara el necessites,
# i elimina la línia quan acabes de provar.
# CORS_ALLOW_ORIGIN=https://spark-6169.cipfpbatoi.lan;http://localhost:3000

# Genera amb: openssl rand -base64 48
WEBUI_SECRET_KEY=CANVIA_AQUEST_SECRET

# Només per al primer arranque. Després de validar l'admin, elimina estes
# variables del .env o deixa-les buides i canvia la contrasenya des de la UI.
WEBUI_ADMIN_NAME=Administrador IA
WEBUI_ADMIN_EMAIL=admin@example.invalid
WEBUI_ADMIN_PASSWORD=CANVIA_AQUESTA_CONTRASENYA

# Clau VIRTUAL de LiteLLM per a la connexió d'Open WebUI (mai la clau
# mestra). Es genera DESPRÉS d'alçar postgres+vllm+litellm, amb:
#   ./scripts/litellm-create-key.sh openwebui-service
# Vegeu README.md, secció "Desplegament".
OPENWEBUI_LITELLM_API_KEY=sk-CANVIA_ACI

# Sessions. Mantindre true quan s'accedisca per HTTPS.
# Per provar temporalment la UI en http://127.0.0.1:3000, es pot posar false.
WEBUI_SESSION_COOKIE_SECURE=true
JWT_EXPIRES_IN=8h

# PostgreSQL + pgvector: base d'Open WebUI (usuaris, xats, vectors) i base de
# LiteLLM (claus, usuaris, pressupostos, logs), en rols separats dins del
# mateix clúster. No es publica cap port; només és accessible des de la
# xarxa Docker.
# Genera cada contrasenya amb: openssl rand -hex 24
# (NO uses -base64 ací: pot generar '/', '+' o '=' i eixos caràcters
# trenquen l'anàlisi de la URL postgresql://usuari:contrasenya@host/bd que
# fa Prisma dins de LiteLLM — falla amb "invalid port number in database
# URL" encara que la contrasenya siga vàlida per a Postgres.)
POSTGRES_DB=openwebui
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=CANVIA_AQUESTA_CONTRASENYA
LITELLM_POSTGRES_DB=litellm
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=CANVIA_AQUESTA_CONTRASENYA

# LiteLLM: gateway central de models i claus.
# Clau mestra (accés total: admin, /ui, crear/revocar claus). NO l'uses mai
# en Open WebUI, scripts d'usuari ni automatitzacions.
# Genera amb: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-CANVIA_ACI
# Xifra en la base de dades les claus de proveïdor (VLLM_*_API_KEY) que
# LiteLLM guarda. Fixa-la sempre: si es regenera sola en cada arrancada, es
# perd l'accés a les dades ja xifrades amb la clau anterior.
# Genera amb: openssl rand -base64 48
LITELLM_SALT_KEY=CANVIA_AQUEST_SECRET
LITELLM_CPUS=4
LITELLM_MEMORY_LIMIT=4g

# Claus internes entre LiteLLM i cada servidor vLLM (xarxa Docker interna,
# no viatgen fora de la DGX; encara així, no les deixes buides).
# Genera cada una amb: echo "sk-$(openssl rand -hex 32)"
VLLM_EMBEDDINGS_API_KEY=sk-CANVIA_ACI
VLLM_REASONING_API_KEY=sk-CANVIA_ACI
VLLM_CODING_API_KEY=sk-CANVIA_ACI

# Token de Hugging Face. Només cal si algun dels models triats és d'accés
# restringit (gated). Deixa-ho buit si tots els models són públics.
HF_TOKEN=

# Model d'embeddings. BAAI/bge-m3 és públic.
VLLM_EMBEDDINGS_MODEL=BAAI/bge-m3
VLLM_EMBEDDINGS_GPU_MEM_UTIL=0.10
VLLM_EMBEDDINGS_MAX_MODEL_LEN=8192
VLLM_EMBEDDINGS_CPUS=4
VLLM_EMBEDDINGS_MEMORY_LIMIT=16g

# Model de raonament profund. openai/gpt-oss-120b requereix una versió de
# vLLM amb suport per al format MXFP4 nativament: verifica-ho abans de
# desplegar (docker compose logs vllm-reasoning si falla en arrancar).
VLLM_REASONING_MODEL=openai/gpt-oss-120b
VLLM_REASONING_GPU_MEM_UTIL=0.65
VLLM_REASONING_MAX_MODEL_LEN=32768
VLLM_REASONING_CPUS=12
VLLM_REASONING_MEMORY_LIMIT=100g

# Model de programació/ús general. Servei opcional, només amb
# `docker compose --profile coding up -d` (vegeu README.md sobre memòria
# unificada compartida amb vllm-reasoning).
VLLM_CODING_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
VLLM_CODING_GPU_MEM_UTIL=0.20
VLLM_CODING_MAX_MODEL_LEN=32768
VLLM_CODING_CPUS=8
VLLM_CODING_MEMORY_LIMIT=40g

# Ports de depuració locals per a compose.dev.yaml (accés directe a cada
# vLLM, sense passar per LiteLLM).
VLLM_EMBEDDINGS_HOST_PORT=8001
VLLM_REASONING_HOST_PORT=8002
VLLM_CODING_HOST_PORT=8003

# Recursos d'Open WebUI i PostgreSQL. La memòria de DGX Spark és unificada:
# repartix-la entre CPU, OS i els vLLM (VLLM_*_MEMORY_LIMIT / GPU_MEM_UTIL)
# amb marge, no sumes tots els límits fins al total físic.
OPEN_WEBUI_CPUS=4
OPEN_WEBUI_MEMORY_LIMIT=8g
POSTGRES_CPUS=4
POSTGRES_MEMORY_LIMIT=8g

# Apache Tika: processament de documents amb extracció de contingut.
TIKA_JVM_OPTS="-Xmx3g -Xms512m"
TIKA_CPUS=4
TIKA_MEMORY_LIMIT=4g
