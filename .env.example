# Versions fixades del desplegament. No s'utilitza latest.
OLLAMA_VERSION=0.31.1
OPEN_WEBUI_VERSION=v0.10.2
POSTGRES_IMAGE_TAG=pg16

# UID/GID interns dels contenidors no privilegiats.
APP_UID=10001
APP_GID=10001

# Publicació local en la DGX.
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=3000

# URL publicada pel proxy invers o túnel HTTPS.
WEBUI_URL=https://ia-professorat.cipfpbatoi.lan

# Genera amb: openssl rand -base64 48
WEBUI_SECRET_KEY=CANVIA_AQUEST_SECRET

# Només per al primer arranque. Després de validar l'admin, elimina estes
# variables del .env o deixa-les buides i canvia la contrasenya des de la UI.
WEBUI_ADMIN_NAME=Administrador IA
WEBUI_ADMIN_EMAIL=admin@example.invalid
WEBUI_ADMIN_PASSWORD=CANVIA_AQUESTA_CONTRASENYA

# Sessions. Mantindre true quan s'accedisca per HTTPS.
# Per provar temporalment la UI en http://127.0.0.1:3000, es pot posar false.
WEBUI_SESSION_COOKIE_SECURE=true
JWT_EXPIRES_IN=8h

# PostgreSQL + pgvector: base principal d'Open WebUI i base vectorial.
# No es publica cap port; només és accessible des de la xarxa Docker.
# Genera la contrasenya amb: openssl rand -base64 36
POSTGRES_DB=openwebui
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=CANVIA_AQUESTA_CONTRASENYA

# Ollama: valors conservadors per a començar en DGX Spark.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=32
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Recursos. La memòria de DGX Spark és unificada.
OLLAMA_CPUS=16
OLLAMA_MEMORY_LIMIT=100g
OPEN_WEBUI_CPUS=4
OPEN_WEBUI_MEMORY_LIMIT=8g
POSTGRES_CPUS=4
POSTGRES_MEMORY_LIMIT=8g
